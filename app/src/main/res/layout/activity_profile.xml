<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student Profile"
            android:textColor="#222222"
            android:textSize="26sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="28dp" />

        <TextView
            android:id="@+id/tvProfileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Name: Loading..."
            android:textSize="18sp"
            android:textColor="#222222"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvProfileDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Department: Loading..."
            android:textSize="18sp"
            android:textColor="#222222"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvProfileStudentId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student ID: Loading..."
            android:textSize="18sp"
            android:textColor="#222222"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvProfileBatch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Batch: Loading..."
            android:textSize="18sp"
            android:textColor="#222222"
            android:padding="12dp" />

        <TextView
            android:id="@+id/tvProfileEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email: Loading..."
            android:textSize="18sp"
            android:textColor="#222222"
            android:padding="12dp" />

        <Button
            android:id="@+id/btnBackProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Back"
            android:textAllCaps="false"
            android:layout_marginTop="24dp" />

    </LinearLayout>

</ScrollView>
