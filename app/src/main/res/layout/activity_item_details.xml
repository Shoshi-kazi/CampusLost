<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F7F8FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <ImageView
            android:id="@+id/ivDetailsImage"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:background="#E3EAF2"
            android:scaleType="centerCrop"
            android:src="@android:drawable/ic_menu_gallery"
            android:contentDescription="Item image" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="18dp"
            android:layout_marginTop="16dp">

            <TextView
                android:id="@+id/tvDetailsTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Item Title"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#263B53" />

            <TextView
                android:id="@+id/tvDetailsDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="16sp"
                android:textColor="#333333"
                android:lineSpacingExtra="4dp"
                android:layout_marginTop="14dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E3EAF2"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:id="@+id/tvDetailsLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Location"
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/tvDetailsType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Lost / Found"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#405D7A"
                android:layout_marginTop="12dp" />

            <TextView
                android:id="@+id/tvDetailsPoster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Posted By: Loading..."
                android:textSize="16sp"
                android:textColor="#333333"
                android:layout_marginTop="18dp" />

            <TextView
                android:id="@+id/tvDetailsContact"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact Number: Loading..."
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#263B53"
                android:layout_marginTop="12dp" />

        </LinearLayout>

        <Button
            android:id="@+id/btnEdit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Item"
            android:textColor="#FFFFFF"
            android:backgroundTint="#263B53"
            android:layout_marginTop="20dp" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Delete Item"
            android:textColor="#FFFFFF"
            android:backgroundTint="#A94442"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</ScrollView>
