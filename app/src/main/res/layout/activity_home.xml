<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="#F7F8FA">

    <!-- App Title -->

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="CampusLost"
        android:textSize="27sp"
        android:textStyle="bold"
        android:textColor="#263B53"
        android:paddingTop="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Find what you lost. Help others find theirs."
        android:textSize="14sp"
        android:textColor="#737D89"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="14dp"/>

    <!-- Search Bar -->

    <SearchView
        android:id="@+id/searchView"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:queryHint="Search items..."
        android:iconifiedByDefault="false"
        android:background="#FFFFFF"
        android:queryBackground="@android:color/transparent" />

    <!-- Profile Button -->

    <Button
        android:id="@+id/btnProfile"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="My Profile"
        android:textAllCaps="false"
        android:textColor="#263B53"
        android:backgroundTint="#E3EAF2"
        android:layout_marginTop="10dp"/>

    <!-- Filter Buttons -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp">

        <Button
            android:id="@+id/btnAll"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="All"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:backgroundTint="#405D7A"/>

        <Button
            android:id="@+id/btnLost"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="Lost"
            android:textAllCaps="false"
            android:textColor="#263B53"
            android:backgroundTint="#E3EAF2"/>

        <Button
            android:id="@+id/btnFound"
            android:layout_width="0dp"
            android:layout_height="45dp"
            android:layout_weight="1"
            android:text="Found"
            android:textAllCaps="false"
            android:textColor="#263B53"
            android:backgroundTint="#E3EAF2"/>

    </LinearLayout>

    <!-- Add Item Button -->

    <Button
        android:id="@+id/btnAddItem"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:text="+ Add Lost Item"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textColor="#FFFFFF"
        android:backgroundTint="#405D7A"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"/>

    <!-- Lost and Found Items -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingTop="8dp"
        android:clipToPadding="false"/>

    <!-- Logout Button -->

    <Button
        android:id="@+id/btnLogout"
        android:layout_width="match_parent"
        android:layout_height="45dp"
        android:text="Logout"
        android:textAllCaps="false"
        android:textColor="#A33A3A"
        android:backgroundTint="#F1E6E6"
        android:layout_marginTop="6dp"/>

</LinearLayout>
